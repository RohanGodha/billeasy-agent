# ===========================================================================
# counter-copilot — environment variables
# Counter Copilot: revenue-assurance and settlement copilot for Billeasy Area
# Partner Managers (retail POS outlets + government transit ticketing counters).
# Copy to backend/.env (local) or set in Render dashboard (prod)
# ===========================================================================

# --- App ---
APP_NAME=counter-copilot
APP_ENV=development                  # development | production
APP_PASSWORD=shared                   # shared password gate (clients send X-Access-Token)
APP_CORS_ORIGINS=http://localhost:5173,https://counter-copilot.vercel.app
LOG_LEVEL=INFO

# --- LLM Providers ---
# At least one of these should be set. The router will gracefully degrade to
# the deterministic "mock" provider if all are missing — useful for offline dev.

# Claude leads the reasoning route (planner / critic / synthesizer).
# ANTHROPIC_EFFORT trades thinking depth against latency: low | medium | high.
# This is an interactive agent, so it defaults to low.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBED_MODEL=text-embedding-004

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Data Layer ---
# The counter network: counters, counter_health, transactions, modules,
# counter_modules and field_notes.
# If DATABRICKS_* is set, the FailoverSource will try Databricks first.
# Otherwise SQLite is used directly.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=counter_copilot
DATABRICKS_SCHEMA=core
DATABRICKS_TIMEOUT_SECONDS=5

SQLITE_PATH=./data/app.db
CHROMA_DIR=./data/chroma

# --- Agent ---
AGENT_MAX_ITERATIONS=10
AGENT_TOP_K_CANDIDATES=10
AGENT_TOOL_TIMEOUT_SECONDS=15

# --- Self-ping keep-alive (Render free tier) ---
SELF_PING_URL=
SELF_PING_INTERVAL_SECONDS=600
